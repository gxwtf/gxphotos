# ===== 原图目录 =====
# Node 与 Python（人脸检索）共用同一个变量；nginx 也从这里直接托管 /photos/
# 生产：必须指向【项目之外】的绝对路径！
#   原因：next build 会读取并驻留项目树内的文件，10G 级原图放在项目里会导致构建 OOM。
# 开发：不设置时默认 <项目>/photos_data（只适合放少量样图）
PHOTOS_DIR=/data/gxphotos/photos

# 学生大头照目录（可选，人脸检索用；默认 public/students）
# STUDENT_DIR=/data/gxphotos/students

# ===== 人脸检索服务配置 =====
# 服务监听地址（默认 localhost，如需外部访问可改为 0.0.0.0）
FACE_API_HOST=localhost

# 服务端口
FACE_API_PORT=8001

# Next.js 前端访问人脸服务的 URL
NEXT_PUBLIC_FACE_API_URL=http://localhost:8001

# GPU 配置（如需使用 GPU 加速，设置为 true）
# FACE_API_USE_GPU=false

# CPU 线程数（仅在非 GPU 模式下生效）
# FACE_API_THREADS=8
